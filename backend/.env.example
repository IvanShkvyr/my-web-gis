# ============================================================
# .env.example — public template, safe to commit to git.
# Copy it: cp .env.example .env
# ============================================================

# Individual parts — reserved for future pydantic-settings refactor.
# Leave empty if you use DATABASE_URL above.
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=postgres

# --- JWT ---
# Secret key for JWT token signing (required when auth is added).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
# Runtime environment: "development" or "production"
APP_ENV=development
CORS_ORIGINS=http://localhost:8000,http://localhost:5501
